dev tun
persist-tun
persist-key
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305:AES-256-CBC
data-ciphers-fallback AES-256-CBC
auth SHA256
tls-client
client
resolv-retry infinite
remote 192.168.1.82 1194 udp4
nobind
verify-x509-name "OpenVPN_Server_GSR" name
auth-user-pass
pkcs12 gw-UDP4-1194-store.p12
tls-auth gw-UDP4-1194-store-tls.key 1
remote-cert-tls server
explicit-exit-notify

